{
  "function_name": "shortest_paths",
  "test_cases": [
    {
      "parameters": {"n":5, "edges":[[0,1,2],[0,2,5],[1,2,1],[1,3,3],[2,3,1],[3,4,2]]},
      "expected_output": [0, 2, 3, 4, 6]
    },
    {
      "parameters": {"n":3, "edges":[[0,1,4],[1,2,6]]},
      "expected_output": [0, 4, 10]
    },
    {
      "parameters": {"n":4, "edges":[[0,1,1],[1,2,2],[2,3,3],[0,3,10]]},
      "expected_output": [0, 1, 3, 6]
    },
    {
      "parameters": {"n":3, "edges":[[1,2,5]]},
      "expected_output": [0, -1, -1]
    },
    {
      "parameters": {"n":2, "edges":[[0,1,0]]},
      "expected_output": [0, 0]
    }
  ]
}
